[Unit]
Description=Agent Services — Monolith (single process, backward compatible)
After=network.target
Conflicts=agent-services.target

[Service]
Type=simple
WorkingDirectory=/opt/vers-agent-services
ExecStart=/usr/bin/node dist/server.js
Environment=NODE_ENV=production
Environment=MONOLITH=true
Environment=PORT=3000
EnvironmentFile=-/opt/vers-agent-services/.env
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-monolith

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/vers-agent-services/data

[Install]
WantedBy=multi-user.target
