[Unit]
Description=Agent Services — Gateway (reverse proxy, UI, auth)
After=network.target agent-core.service agent-fleet.service agent-autonomy.service
Requires=agent-core.service agent-fleet.service agent-autonomy.service
PartOf=agent-services.target

[Service]
Type=simple
WorkingDirectory=/opt/vers-agent-services
ExecStart=/usr/bin/node dist/gateway/main.js
Environment=NODE_ENV=production
Environment=GATEWAY_PORT=3000
EnvironmentFile=-/opt/vers-agent-services/.env
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-gateway

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/vers-agent-services/data

[Install]
WantedBy=agent-services.target
