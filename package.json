{
  "name": "vers-agent-services",
  "version": "0.1.0",
  "description": "Lightweight coordination services for Vers agent swarms — shared task board, activity feed, skill registry, and more",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:gateway": "tsx watch src/gateway/main.ts",
    "dev:core": "tsx watch src/core-api/main.ts",
    "dev:fleet": "tsx watch src/fleet-api/main.ts",
    "dev:autonomy": "tsx watch src/autonomy-api/main.ts",
    "build": "tsc",
    "postbuild": "rm -rf dist/ui/static && cp -r src/ui/static dist/ui/static",
    "start": "node dist/server.js",
    "start:gateway": "node dist/gateway/main.js",
    "start:core": "node dist/core-api/main.js",
    "start:fleet": "node dist/fleet-api/main.js",
    "start:autonomy": "node dist/autonomy-api/main.js",
    "start:microservices": "node dist/core-api/main.js & node dist/fleet-api/main.js & node dist/autonomy-api/main.js & sleep 1 && node dist/gateway/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.0",
    "@sinclair/typebox": "^0.34.48",
    "better-sqlite3": "^12.6.2",
    "duckdb": "^1.4.4",
    "hono": "^4.0.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.52.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/agent-services.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
